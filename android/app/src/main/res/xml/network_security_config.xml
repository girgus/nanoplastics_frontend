<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow cleartext traffic only for emulator development IP -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>

  <!-- Allow cleartext traffic for production server IP -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">37.27.247.129</domain>
  </domain-config>

  <!-- Allow cleartext traffic for localhost development -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>

  <!-- Allow HTTPS for production API (Android requires explicit config) -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">api.nanosolve.org</domain>
  </domain-config>
</network-security-config>
